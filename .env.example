# Manga Scantrad backend (server process; keep secrets in .env, never here)
# SCANTRAD_USER_DATA_DIR=.playwright_user_data/scantrad  # local default; use a unique dir per instance
# SCANTRAD_CDP_URL=http://127.0.0.1:9222  # recommended local Chrome mode
# SCANTRAD_HEADLESS=true
# SCANTRAD_USER_AGENT=  # optional override; otherwise derived from Chromium
# SCANTRAD_PROXY_SERVER=http://proxy.example:8080
# SCANTRAD_PROXY_USERNAME=
# SCANTRAD_PROXY_PASSWORD=
# SOCKS5 proxy authentication and credentials embedded in the proxy URL are not supported
# SCANTRAD_COOKIES_PATH=./scantrad-cookies.json
# Alternative to SCANTRAD_COOKIES_PATH: SCANTRAD_COOKIES_JSON=[...]
